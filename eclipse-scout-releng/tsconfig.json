{
  "compilerOptions": {
    "allowJs": true,
    "target": "ESNext",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "./bin/**/*",
    "./scripts/**/*",
    "./test/**/*"
  ]
}
